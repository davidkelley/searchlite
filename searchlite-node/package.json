{
	"name": "searchlite-js",
	"version": "0.2.8",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"napi": {
		"binaryName": "searchlite",
		"targets": [
			"x86_64-apple-darwin",
			"aarch64-apple-darwin",
			"x86_64-unknown-linux-gnu",
			"aarch64-unknown-linux-gnu",
			"x86_64-pc-windows-msvc"
		]
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/davidkelley/searchlite.git",
		"directory": "searchlite-node"
	},
	"homepage": "https://github.com/davidkelley/searchlite/tree/main/searchlite-node#readme",
	"bugs": "https://github.com/davidkelley/searchlite/issues",
	"keywords": [
		"search",
		"full-text",
		"index",
		"native",
		"rust",
		"napi",
		"embedded"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"zod": ">=4.3.6 <5.0.0"
	},
	"peerDependenciesMeta": {
		"zod": {
			"optional": true
		}
	},
	"devDependencies": {
		"zod": "^4.4.3",
		"@biomejs/biome": "^2",
		"@napi-rs/cli": "^3",
		"@swc/cli": "^0.8",
		"@swc/core": "^1",
		"@types/node": "^25.7.0",
		"typescript": "^6",
		"vitest": "^4"
	},
	"engines": {
		"node": ">= 20"
	},
	"scripts": {
		"artifacts": "napi artifacts",
		"build:native": "napi build --platform --release",
		"build:native:debug": "napi build --platform",
		"build:ts": "swc src -d dist --strip-leading-paths && tsc",
		"build": "npm run build:native && npm run build:ts",
		"build:debug": "npm run build:native:debug && npm run build:ts",
		"prepublishOnly": "napi prepublish -t npm",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:types": "tsc --noEmit -p tsconfig.test.json",
		"typecheck": "tsc && npm run test:types",
		"lint": "biome check .",
		"lint:fix": "biome check --write ."
	},
	"files": [
		"dist",
		"LICENSE",
		"*.node"
	]
}
